# Production environment configuration
# Copy this to .env and fill in your values

# Application
APP_ENV=production
DEBUG=false

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication (simple username/password)
AUTH_USERNAME=your-username
AUTH_PASSWORD=your-secure-password
AUTH_SECRET=generate-a-random-64-char-string-here

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5

# Rate Limiting
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_UNAUTHENTICATED=20

# CORS (only your production domain)
CORS_ORIGINS=["https://narrowli.com","https://www.narrowli.com"]
